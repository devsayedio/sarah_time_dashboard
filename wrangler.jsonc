{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarah-time-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sarah-time-dashboard.royalcourtbd.com",
      "custom_domain": true
    }
  ],
  "define": {
    "__dirname": "\"/\""
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_CACHE",
      "id": "8a18de16b5c846dabf940f31ace06948"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "DEPLOY_ENV": "production"
  }
}
